APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@<pooler-host>:5432/postgres
DB_POOL_MAX=5

# Gemini (verify current model IDs and limits before launch)
GEMINI_API_KEY=
GEN_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004
EMBED_DIM=768
EMBED_BATCH=50
LLM_TIER=free
GEMINI_RPM=15
GEMINI_DAILY_CALL_BUDGET=1500

# RAG
TOP_K=5
RETRIEVAL_MIN_SCORE=0.50
CHUNK_TOKENS=800
CHUNK_OVERLAP=120
CONDENSE_ENABLED=true

# Limits
MAX_FILE_MB=10
MAX_PAGES=150
MAX_CHUNKS_PER_DOC=400
MAX_WORKSPACES_PER_USER=3
MAX_DOCS_PER_WORKSPACE=10
MAX_CHUNKS_PER_USER=1500
DAILY_QUESTIONS_PER_USER=30
DAILY_UPLOADS_PER_USER=10
DEMO_QUESTIONS_PER_IP_DAY=15
KEEP_ORIGINALS=true

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
